@article{darios_genetics_2022,
	title = {Genetics in hereditary spastic paraplegias: {Essential} but not enough},
	volume = {72},
	issn = {0959-4388},
	shorttitle = {Genetics in hereditary spastic paraplegias},
	url = {https://www.sciencedirect.com/science/article/pii/S0959438821000751},
	doi = {10.1016/j.conb.2021.07.005},
	abstract = {Hereditary spastic paraplegias consist of a group of rare neurodegenerative diseases characterized by lower limb spasticity. These inherited Mendelian disorders show high genetic variability associated with wide clinical diversity. Pathophysiological investigations have suggested that mutations in genes affecting the same cellular pathway generally lead to similar clinical symptoms, highlighting the importance of genetic mutation in these diseases. However, phenotype-genotype correlations have failed to explain the observed large inter-individual variability linked to mutations in a single gene, suggesting that genetics alone is not sufficient to explain symptom diversity. The identification of biomarkers, such as neurofilament light chain, could fill the gap and predict disease evolution.},
	urldate = {2024-10-11},
	journal = {Current Opinion in Neurobiology},
	author = {Darios, Frédéric and Coarelli, Giulia and Durr, Alexandra},
	month = feb,
	year = {2022},
	pages = {8--14},
	file = {ScienceDirect Snapshot:/Users/paulinedudek/Zotero/storage/VN9U9NWQ/S0959438821000751.html:text/html},
}

