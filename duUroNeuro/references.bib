	keywords = {Animals, Humans, Mutation, Intermediate Filaments, Neurodegenerative Diseases, Amyotrophic Lateral Sclerosis, Neurodegeneration, Cytoskeleton, Charcot-Marie-tooth (CMT) disease, Cytoskeletal Proteins, Giant axonal neuropathy (GAN), Neurofilaments, Protein aggregation, Protein degradation},
	pages = {19},
	file = {Texte intégral:/Users/paulinedudek/Zotero/storage/D2X74V7V/Didonna et Opal - 2019 - The role of neurofilament aggregation in neurodege.pdf:application/pdf},
}

