	pmcid = {PMC4764191},
	keywords = {Animals, Humans, Female, Spastic Paraplegia, Hereditary, Mutation, Adenosine Triphosphatases, Phenotype, Disease Models, Animal, Microtubules, Caenorhabditis elegans, Drosophila, Endoplasmic Reticulum, Endoplasmic Reticulum Stress, Locomotion, Phenazines, Zebrafish},
	pages = {1088--1099},
