@article{diniz_de_lima_randomized_2021,
	title = {Randomized {Trial} of {Botulinum} {Toxin} {Type} {A} in {Hereditary} {Spastic} {Paraplegia} - {The} {SPASTOX} {Trial}},
	volume = {36},
	issn = {1531-8257},
	doi = {10.1002/mds.28523},
	abstract = {BACKGROUND: Hereditary spastic paraplegia presents spasticity as the main clinical manifestation, reducing gait quality and producing incapacity. Management with botulinum toxin type A (BoNT-A) is not well elucidated. The objective of the current study was to evaluate the efficacy and safety of BoNT-A in patients with hereditary spastic paraplegias.
METHODS: This was a double-blind, randomized, placebo-controlled crossover trial. Each participant was randomly assigned to receive 1 injection session of either BoNT-A (100 IU/2 mL of Prosigne in each adductor magnus and each triceps surae) or saline 0.9\% (2 mL). The primary outcome measure was change from baseline in maximal gait velocity, and secondary outcome measures included changes in gait at self-selected velocity, spasticity, muscle strength, Spastic Paraplegia Rating Scale, pain, fatigue, and subjective perception of improvement. We also looked at adverse events reported by the patients.
RESULTS: We enrolled 55 patients, 36 of whom were men and 41 with the pure phenotype. Mean age was 43 ± 13.4 years (range, 19-72 years), mean age of onset waws 27 ± 13.1 years (range, {\textless}1 to 55 yars), and mean disease duration was 17 ± 12.7 years (range, 1-62 years). Compared with baseline, we did not find significant differences between groups in primary and secondary outcomes, except for reduction in adductor tone (P = 0.01). The adverse events were transient and tolerable, and their incidence did not significantly differ between treatments (P = 0.17).
CONCLUSIONS: BoNT-A was safe in patients with hereditary spastic paraplegias and reduced the adductor tone, but it was not able to produce functional improvement considering the doses, injection protocol, measures, and instruments used. © 2021 International Parkinson and Movement Disorder Society.},
	language = {eng},
	number = {7},
	journal = {Mov Disord},
	author = {Diniz de Lima, Fabricio and Faber, Ingrid and Servelhere, Katiane R. and Bittar, Maria Fernanda R. and Martinez, Alberto R. M. and Piovesana, Luiza G. and Martins, Melina P. and Martins, Carlos Roberto and Benaglia, Tatiana and de Sá Carvalho, Benilton and Nucci, Anamarli and França, Marcondes C.},
	month = jul,
	year = {2021},
	pmid = {33595142},
	keywords = {Humans, Child, Child, Preschool, Infant, Male, Adolescent, Botulinum Toxins, Type A, Adult, Middle Aged, Spastic Paraplegia, Hereditary, hereditary spastic paraplegia, Young Adult, botulinum toxin A, clinical trial, Double-Blind Method, gait, Muscle Spasticity, Neuromuscular Agents, spasticity, Treatment Outcome},
	pages = {1654--1663},
}

@article{kelly_prospective_2017,
	title = {Prospective evaluation of {Peristeen}® transanal irrigation system with the validated neurogenic bowel dysfunction score sheet in the pediatric population},
	volume = {36},
	issn = {1520-6777},
	doi = {10.1002/nau.22979},
	abstract = {AIMS: To determine the ability of Peristeen® transanal irrigation system to reduce symptoms of neurogenic bowel dysfunction (NBD) in patients using the validated neurogenic bowel dysfunction scoring system for the pediatric population.
METHODS: Patients 3-21 years with NBD whose current bowel program was unsuccessful were given the Neurogenic Bowel Dysfunction (NBoDS) score sheet before initiating Peristeen®, and at 2 weeks, 2 months, and 6 months after. All patients were started on Peristeen® with tap water (20 ml/kg) per daily irrigation. Mean and paired t-tests were completed.
RESULTS: 24 patients were enrolled and had follow-up. Mean age was 10.5 years (range 3-21 years), 25\%, 50\%, 25\% had thoracic, lumbar and sacral level lesions respectively. Mean NBoDS score at initiation of Peristeen® was 20.21 (±5.56), n = 24. The mean score after two weeks of use was 12.75 (±4.40), n = 24. There was a statistically significant decrease of 7.46 (95\%CI, 5.07-9.84) points, t(23) = 6.47, P {\textless} 0.0005 after two weeks. There was a statistically significant decrease in their scores from initiation to the 2 month time period of 7.00 (95\%CI, 2.18-11.82) points, t(9) = 3.29, P = 0.009. By the sixth month of daily use the mean NBoDS score was 9.67 (n = 12). This was an average decrease of 8.83 (95\%CI, 5.39-12.28) points from initiation score, t(11) = 5.641, P {\textless} 0.005.
CONCLUSION: The Peristeen® transanal irrigation system provides a significant reduction in NBoDS scores in pediatric patients with NBD. Peristeen® should be considered when other conservative bowel management options have been unsuccessful. Neurourol. Urodynam. 36:632-635, 2017. © 2016 Wiley Periodicals, Inc.},
	language = {eng},
	number = {3},
	journal = {Neurourol Urodyn},
	author = {Kelly, Maryellen S. and Dorgalli, Crystal and McLorie, Gordon and Khoury, Antoine E.},
	month = mar,
	year = {2017},
	pmid = {26879474},
	keywords = {Humans, Intestines, Child, Child, Preschool, Female, Male, Adolescent, Prospective Studies, Young Adult, Treatment Outcome, neurogenic bowel, Neurogenic Bowel, neurogenic bowel dysfunction score, peristeen, spina bifida, Therapeutic Irrigation, transanal irrigation},
	pages = {632--635},
}

