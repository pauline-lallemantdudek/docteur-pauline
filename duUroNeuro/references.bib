	keywords = {Humans, Infant, Male, Neural Tube Defects, Spinal Dysraphism, Meningomyelocele, Magnetic Resonance Imaging, Tomography, X-Ray Computed, Spinal Cord, Abnormalities, Multiple, Neurosurgical Procedures},
	pages = {376--379},
}

