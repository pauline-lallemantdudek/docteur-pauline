	pmid = {26980106},
	pmcid = {PMC4989202},
	keywords = {Humans, Female, Adult, Middle Aged, Alleles, Biomarkers, Tumor, BRCA1 Protein, BRCA2 Protein, Breast Neoplasms, Heterozygote, Huntingtin Protein, Receptor, ErbB-2, Trinucleotide Repeats},
	pages = {1310--1315},
