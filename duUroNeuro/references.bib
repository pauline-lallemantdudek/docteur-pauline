	year = {2002},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/humu.10105},
	keywords = {Germany, hereditary spastic paraplegia, SPG4, HSP, spastin},
	pages = {127--132},
	file = {Full Text PDF:/Users/paulinedudek/Zotero/storage/9EJ48E2D/Sauter et al. - 2002 - Mutation analysis of the spastin gene (SPG4) in pa.pdf:application/pdf;Snapshot:/Users/paulinedudek/Zotero/storage/42U8L3RN/humu.html:text/html},
