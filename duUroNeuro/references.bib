	doi = {10.1016/S1474-4422(15)00217-3},
	abstract = {Inherited cerebellar ataxias need therapeutic interventions. A key question is how
to run conclusive therapeutic trials. Patient groups are very small, and the risk
of being underpowered to test efficacy is important. Cerebellar ataxias, which include
