	pmcid = {PMC2441586},
	keywords = {Humans, Child, Adolescent, Mutation, Retrospective Studies, DNA Mutational Analysis, Young Adult, Age of Onset, Phenotype, Spinocerebellar Ataxias, Cohort Studies, Heterozygote, Netherlands, Heat-Shock Proteins, Genes, Recessive, Homozygote},
	pages = {207--214},
