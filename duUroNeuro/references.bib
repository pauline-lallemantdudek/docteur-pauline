	pages = {961--971},
	file = {Pérez-Brangulí et al. - 2019 - Human SPG11 cerebral organoids reveal cortical neu.pdf:/Users/paulinedudek/Zotero/storage/FW5EPY9P/Pérez-Brangulí et al. - 2019 - Human SPG11 cerebral organoids reveal cortical neu.pdf:application/pdf;Texte intégral:/Users/paulinedudek/Zotero/storage/8VB6ZMMW/Pérez-Brangulí et al. - 2019 - Human SPG11 cerebral organoids reveal cortical neu.pdf:application/pdf},
