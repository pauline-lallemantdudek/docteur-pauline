	note = {Publisher: BMJ Publishing Group Ltd
Section: Neurodegeneration},
	keywords = {multiple sclerosis, dementia, motor neuron disease, Parkinson's disease, traumatic brain injury},
	pages = {870--881},
	file = {Version soumise:/Users/paulinedudek/Zotero/storage/PR9SLE3E/Gaetani et al. - 2019 - Neurofilament light chain as a biomarker in neurol.pdf:application/pdf},
