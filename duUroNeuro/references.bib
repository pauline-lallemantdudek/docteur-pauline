@article{ledson_prevalence_1998,
	title = {Prevalence and mechanisms of gastro-oesophageal reflux in adult cystic fibrosis patients},
	volume = {91},
	issn = {0141-0768},
	abstract = {Gastro-oesophageal reflux (GOR) occurs frequently in children with cystic fibrosis (CF) but has not been studied in adult CF. We surveyed such symptoms by structured questionnaire in 50 adult CF patients (mean age 26 years, range 16-50; 24 male) and performed oesophageal manometry and 24-hour pH recording in 10 who had reflux symptoms (mean age 28 years, range 21-35; 8 men). 47 patients (94\%) had upper gastrointestinal symptoms: 40 (80\%) heartburn (27 worse when supine); 26 (52\%) regurgitation; and 28 (56\%) dyspepsia. At oesophageal manometry, lower oesophageal sphincter barrier pressure (LOSBP) was subnormal in 6 of the 10 patients and 3 had uncoordinated peristalsis in the mid oesophagus. 8 patients had raised DeMeester scores, indicating significant GOR. Those patients with a LOSBP {\textless} 5mm Hg had a higher DeMeester score (mean 81.0, range 47.9-128.8) than the patients with a normal LOSBP (26.9, 8.7-56.5; p {\textless} 0.002). These results show that adult CF patients have high rates of GOR symptoms, diminished LOSBP, and acid reflux.},
	language = {eng},
	number = {1},
	journal = {J R Soc Med},
	author = {Ledson, M. J. and Tran, J. and Walshaw, M. J.},
	month = jan,
	year = {1998},
	pmid = {9536132},
	pmcid = {PMC1296415},
	keywords = {Humans, Female, Male, Adolescent, Adult, Middle Aged, Hydrogen-Ion Concentration, Cystic Fibrosis, Gastroesophageal Reflux, Esophagus, Manometry, Pressure},
	pages = {7--9},
}

@article{birring_induced_2004,
	title = {Induced sputum inflammatory mediator concentrations in chronic cough},
	volume = {169},
	issn = {1073-449X},
	doi = {10.1164/rccm.200308-1092OC},
	abstract = {Previous studies have shown evidence of airway inflammation in patients with chronic cough and have suggested that the cough may be due to release of tussive mediators and activation of afferent sensory nerve endings. We measured the concentration of various proinflammatory and tussive mediators in induced sputum supernatants from 20 patients with cough variant asthma or eosinophilic bronchitis, 20 patients with nonasthmatic chronic cough, 22 patients with idiopathic chronic cough, and 18 healthy control subjects. We measured histamine, cysteinyl-leukotrienes, prostanoids (prostaglandin D2 and prostaglandin E2), and interleukin-8 by enzyme immunoassay. The median sputum histamine concentrations were significantly higher in patients with idiopathic chronic cough (8.0 ng/ml) and cough variant asthma/eosinophilic bronchitis (10.2 ng/ml) than in normal subjects (2.6 ng/ml; 95\% confidence interval of difference from idiopathic chronic cough, 0.8 to 25.8 [p = 0.009] and 95\% confidence interval of difference from cough variant asthma/eosinophilic bronchitis, 1.1 to 20.1 [p = 0.01]). Median sputum prostaglandin D2 and prostaglandin E2 concentrations were significantly higher in all categories of chronic cough. Our findings support the view that there is release of inflammatory and tussive mediators in patients with chronic cough and suggest that there might be similarities in the mechanism of cough in a diverse range of conditions.},
	language = {eng},
	number = {1},
	journal = {Am. J. Respir. Crit. Care Med.},
	author = {Birring, Surinder S. and Parker, Debbie and Brightling, Christopher E. and Bradding, Peter and Wardlaw, Andrew J. and Pavord, Ian D.},
	month = jan,
	year = {2004},
	pmid = {14512269},
	keywords = {Humans, Female, Male, Chronic Disease, Adult, Middle Aged, Severity of Illness Index, Case-Control Studies, Cohort Studies, Statistics, Nonparametric, Prognosis, Reference Values, Sensitivity and Specificity, Cough, Asthma, Sputum, Analysis of Variance, Bronchial Provocation Tests, Bronchitis, Chronic, Bronchoalveolar Lavage Fluid, Inflammation Mediators, Probability},
