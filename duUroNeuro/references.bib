	keywords = {Humans, Spastic Paraplegia, Hereditary, Adenosine Triphosphatases, Mitochondria, Fibroblasts, Cells, Cultured, Phylogeny, Intracellular Membranes, ATP-Dependent Proteases, ATPases Associated with Diverse Cellular Activities, Metalloendopeptidases, Saccharomyces cerevisiae Proteins, Saccharomyces cerevisiae, Cell Respiration, Down-Regulation, Electron Transport Complex I, Macromolecular Substances, Oxidative Stress, Reactive Oxygen Species, Sequence Homology, Nucleic Acid},
	pages = {777--787},
