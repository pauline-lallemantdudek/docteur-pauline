	doi = {10.1186/s13063-020-04932-9},
	abstract = {Discussion: Move-HSP will be the first RCT to assess the effects of C-Mill gait adaptability training in people with pure HSP. It will provide proof of concept for the efficacy of gait adaptability training in people with pure HSP. Trial registration: Clinicaltrials.gov NCT04180098. Registered on November 27, 2019.},
	language = {en},
