@article{ward_thirty-three_2001,
	title = {Thirty-three novel {COL1A1} and {COL1A2} mutations in patients with osteogenesis imperfecta types {I}-{IV}},
	volume = {17},
	issn = {1098-1004},
	doi = {10.1002/humu.1124},
	abstract = {Osteogenesis imperfecta (OI) is a heritable disease of bone characterized by low bone mass and bone fragility. Six different types of OI have been described to date, based on clinical phenotype and histological findings. The genetic defect in many patients with OI types I-IV is due to mutations in the genes encoding type I collagen, while patients with OI types V and VI show no evidence of mutations in the COL1A1/COL1A2 genes. Here we report thirty-three novel mutations in patients with types I-IV OI. Sixteen mutations were in COL1A1 and seventeen were in COL1A2. Most mutations resulted in substitutions for glycine: one of these, a doublet GG{\textgreater}CC transversion, created a unique Gly--{\textgreater}Pro missense mutation in the triple helical domain of COL1A2. Two rare triple helical Gly--{\textgreater}Glu substitutions in COL1A2 are also described. In addition, there were six single-base deletion mutations resulting in frameshifts, seven splice junction mutations, and a 9-bp triple helix insertion associated with a severe (OI II) phenotype. The variety of mutations described in the COL1A1/COL1A2 genes giving rise to an OI phenotype is in accordance with the clinical heterogeneity of the disease. Hum Mutat 17:434, 2001.},
	language = {eng},
	number = {5},
	journal = {Hum. Mutat.},
	author = {Ward, L. M. and Lalic, L. and Roughley, P. J. and Glorieux, F. H.},
	month = may,
	year = {2001},
	pmid = {11317364},
	keywords = {Humans, Female, Male, Mutation, DNA Mutational Analysis, Phenotype, Alternative Splicing, Collagen, Databases as Topic, Exons, Fibroblasts, Genotype, Introns, Mutation, Missense, OSTEOGENESIS IMPERFECTA, Polymorphism, Genetic, Protein Structure, Secondary, Sequence Deletion},
	pages = {434},
}

