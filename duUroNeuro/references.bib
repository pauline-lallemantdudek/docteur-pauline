	pmcid = {PMC3529340},
	keywords = {Animals, Humans, Spastic Paraplegia, Hereditary, Mutation, Spastin, Adenosine Triphosphatases, Axons, Mice, Neurons, Disease Models, Animal, Cells, Cultured, Mice, Knockout, Cerebral Cortex, Microtubules, Axonal Transport, Hippocampus, Models, Neurological, Nocodazole, Paclitaxel, Vinblastine},
	pages = {72--83},
