@incollection{casari_spastic_1993,
	address = {Seattle (WA)},
	title = {Spastic {Paraplegia} 7},
	copyright = {Copyright © 1993-2020, University of Washington, Seattle. GeneReviews is a registered trademark of the University of Washington, Seattle. All rights reserved.},
	url = {http://www.ncbi.nlm.nih.gov/books/NBK1107/},
	abstract = {Spastic paraplegia 7 (SPG7) is characterized by insidiously progressive bilateral leg weakness and spasticity. Most affected individuals have decreased vibration sense and cerebellar signs. Onset is mostly in adulthood, although symptoms may start as early as age 11 years and as late as age 72 years. Additional features including ataxia (gait and limbs), spastic dysarthria, dysphagia, pale optic disks, ataxia, nystagmus, strabismus, ptosis, hearing loss, motor and sensory neuropathy, amyotrophy, scoliosis, pes cavus, and urinary sphincter disturbances may be observed., The diagnosis of SPG7 is established in a proband with typical clinical findings and biallelic pathogenic variants in SPG7 identified by molecular genetic testing., Treatment of manifestations: Drugs that may reduce spasticity and muscle tightness include baclofen, tizanidine, dantrolene, and diazepam. Physical therapy and assistive walking devices often reduce contractures, provide support, and promote stability. Occupational therapy and speech therapy help with activities of daily living. Surveillance: Annual neurologic evaluation to identify potential complications of spasticity, such as contractures., SPG7 is inherited in an autosomal recessive manner. Heterozygotes (carriers) are usually asymptomatic. Each sib of an affected individual has a 25\% chance of being affected, a 50\% chance of being an asymptomatic carrier, and a 25\% chance of being unaffected and not a carrier. Carrier testing for at-risk relatives, prenatal diagnosis for pregnancies at increased risk and preimplantation genetic diagnosis are possible if both pathogenic alleles have been identified in the family.},
	language = {eng},
	urldate = {2020-05-13},
