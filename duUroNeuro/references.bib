	keywords = {Humans, Patient Satisfaction, Quality of Life, Treatment Outcome, Patient Compliance, Physical Therapy Modalities, exercise, physiotherapy, Exercise, Practice Guidelines as Topic, Australia, Consensus, Health Knowledge, Attitudes, Practice, Cystic Fibrosis, cystic fibrosis, Respiratory Function Tests, Respiratory Therapy, airway clearance, Guideline Adherence, inhalation therapy, Mucociliary Clearance, New Zealand, Noninvasive Ventilation},
	pages = {656--667},
